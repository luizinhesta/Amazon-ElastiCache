# ============================================
# Variáveis de Ambiente - Dino Game (Projeto 2)
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais:
#   cp .env.example .env
#
# O arquivo .env NÃO é versionado (está no .gitignore).
# Nunca commite o .env com valores reais.
# ============================================

# Amazon Cognito - User Pool
# Encontra em: Console AWS > Cognito > User Pool > "ID do grupo de usuários"
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Amazon Cognito - App Client ID
# Encontra em: Console AWS > Cognito > User Pool > Integração de aplicativos > Clientes de aplicativos > "ID do cliente"
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway - URL base (sem barra final)
# Encontra em: Console AWS > API Gateway > sua API > Estágios > dev > "Invocar URL"
VITE_API_URL=https://SEU-API-ID.execute-api.us-east-1.amazonaws.com/dev
